        "id": "blank-controller"
      },
      "target": {
        "id": "archive-terminal"
      },
      "flagConditions": {
        "archiveControllerMounted": false
      },
      "sourceComponentConditions": [
        {
          "component_kind": "text_input",
          "component_id": "archive-password-input"
        },
        {
          "component_kind": "button",
          "component_id": "archive-submit-button"
        }
      ],
      "failureMessage": "The terminal needs both a text form and its matching submit button.",
      "effects": [
        {
          "effectKind": "setDocumentVariant",
          "cardId": "archive-terminal",
          "variant": "login"
        },
        {
          "effectKind": "copySourceComponentToTarget",
          "cardId": "archive-terminal",
          "component_kind": "text_input",
          "source_component_id": "archive-password-input"
        },
        {
          "effectKind": "copySourceComponentToTarget",
          "cardId": "archive-terminal",
          "component_kind": "button",
          "source_component_id": "archive-submit-button"
        },
        {
          "effectKind": "setFlag",
          "flag": "archiveControllerMounted",
          "value": true
        },
        {
          "effectKind": "setCardState",
          "cardId": "archive-terminal",
          "key": "controllerMounted",
          "value": true
        },
        {
          "effectKind": "setMessage",
          "message": "The controller seats into the terminal. The archive login is ready."
        }
      ]
    }
  ],
  "formSubmitRules": [
    {
      "id": "nightjar-unlocks-archive",
      "target": {
        "id": "archive-terminal"
      },
      "formId": "archive-login",
      "flagConditions": {
        "archiveControllerMounted": true,
        "archiveUnlocked": false
      },
      "fieldConditions": [
        {
          "name": "password",
          "valueEquals": "NIGHTJAR",
          "trimSpace": true,
          "caseSensitive": false
        }
      ],
      "failureMessage": "ACCESS DENIED. The archive password is incorrect.",
      "effects": [
        {
          "effectKind": "setFlag",
          "flag": "archiveUnlocked",
          "value": true
        },
        {
          "effectKind": "setCardState",
          "cardId": "archive-terminal",
          "key": "unlocked",
          "value": true
        },
        {
          "effectKind": "removeCardTags",
          "cardId": "archive-terminal",
          "tags": [
            "locked"
          ]
        },
        {
          "effectKind": "setDocumentVariant",
          "cardId": "archive-terminal",
          "variant": "unlocked"
        },
        {
          "effectKind": "setMessage",
          "message": "NIGHTJAR accepted. The archive opens."
        }
      ]
    }
